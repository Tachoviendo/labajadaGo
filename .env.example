# Renombrar a .env antes de correr el proyecto (queda en la raiz: lo usan docker-compose y la api)
# Los valores de abajo son para desarrollo. En produccion (servidor) ver el bloque del final.

FASTIFY_LOG_LEVEL=info
FASTIFY_SECRET=MySuperSecr3t
FASTIFY_PORT=3000
# origenes que pueden llamar a la api desde el navegador, separados por coma:
# el front con ng serve y la app de Android (Capacitor la sirve como http://localhost)
CORS_ORIGIN=http://localhost:4200,http://localhost

# --- Postgres (pg toma estas variables automaticamente, no hace falta pasarlas al Pool) ---
# PGPORT es el puerto de la compu donde docker-compose.dev.yaml publica la base
PGUSER=ucu
PGPASSWORD=secretpassword
PGHOST=localhost
PGPORT=5438
PGDATABASE=proyecto

# --- Bucket de imagenes (servicio "bucket" de docker-compose) ---
# BUCKET_URL: donde la api sube los archivos (de servidor a servidor).
# BUCKET_PUBLIC_URL: base de la url que se guarda en imagen_url / foto_entrega_url y que pide el navegador.
#   /bucket es relativa: la atiende el proxy de ng serve (front/proxy.conf.json), asi las imagenes
#   se ven igual en http://localhost:4200 y en https://<ip>:4200 desde el celular
BUCKET_URL=http://localhost:3001
BUCKET_PUBLIC_URL=/bucket
BUCKET_TOKEN=dev-bucket-token

# --- Local (origen de los repartos en el mapa): plaza Artigas, Salto ---
LOCAL_LAT=-31.38876
LOCAL_LNG=-57.96062

# =====================================================================================
# Produccion (/var/www/labajadaGo/.env en el servidor). docker-compose.yml usa ademas:
#
# PROJECT_NAME=labajadago
# FRONTEND_PORT=8080          # el nginx del servidor apunta aca
# POSTGRES_PORT=8081          # solo en 127.0.0.1 del servidor
# CORS_ORIGIN=https://labajadago.graph.uy,http://localhost   # http://localhost = app de Android
#
# y cambiar por valores largos y aleatorios (openssl rand -hex 32):
# FASTIFY_SECRET, PGPASSWORD, BUCKET_TOKEN
#
# PGHOST, PGPORT, BUCKET_URL y BUCKET_PUBLIC_URL los fija docker-compose.yml (red interna).
# =====================================================================================
