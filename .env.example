# Renombrar a .env antes de correr el proyecto (queda en la raiz: lo usan docker-compose y la api)

FASTIFY_LOG_LEVEL=info
FASTIFY_SECRET=MySuperSecr3t
FASTIFY_PORT=3000
CORS_ORIGIN=http://localhost:4200

# --- Postgres (pg toma estas variables automaticamente, no hace falta pasarlas al Pool) ---
PGUSER=ucu
PGPASSWORD=secretpassword
PGHOST=localhost
PGPORT=5432
PGDATABASE=proyecto

# --- Bucket de imagenes (servicio "bucket" de docker-compose) ---
# BUCKET_URL: donde la api sube los archivos. BUCKET_PUBLIC_URL: base de la url que se guarda en producto.imagen_url
BUCKET_URL=http://localhost:3001
BUCKET_PUBLIC_URL=http://localhost:3001
BUCKET_TOKEN=dev-bucket-token
